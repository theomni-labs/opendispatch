{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendispatch.example/contracts/engines/forecaster.output.schema.json",
  "title": "ForecasterOutput",
  "description": "Demand forecast per zone x sub-zone x 15-minute interval. Every value carries low, expected and high. INVARIANTS (JSON Schema cannot express them; validate-contracts and the engine tests check them): (1) low <= expected <= high; (2) field_expected + remote_inferred_expected equals expected within 0.01; (3) 96 intervals per day: interval_index 0 to 95, interval_start aligned to the quarter hour, so a horizon of N days holds N x 96 values for each (zone_id, sub_zone_id) pair, exactly once each; (4) interval_index equals the quarter-hour slot of interval_start in Asia/Riyadh. Values are expected case counts per interval (not integers). Placeholder engines must set illustrative to true; a screen may show a forecast figure as measured only when data_source is LIVE or IMPORTED and illustrative is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "engine",
    "model_version",
    "generated_at",
    "data_source",
    "illustrative",
    "horizon",
    "interval_minutes",
    "intervals_per_day",
    "range_coverage",
    "values"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "$ref": "#/$defs/Uuid" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "forecaster" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_source": { "$ref": "#/$defs/DataSource" },
    "input_data_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/DataSource" }
    },
    "illustrative": {
      "description": "True while the forecast is a placeholder or was produced from synthetic data. Screens show the word Illustrative next to any number when true.",
      "type": "boolean"
    },
    "rule_set_version": { "type": "string", "maxLength": 64 },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "days"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "days": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "interval_minutes": { "const": 15 },
    "intervals_per_day": { "const": 96 },
    "range_coverage": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "values": {
      "type": "array",
      "items": { "$ref": "#/$defs/ForecastIntervalValue" }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "model_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature_set": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 64 },
        "training_start": { "type": "string", "format": "date" },
        "training_end": { "type": "string", "format": "date" },
        "history_days": { "type": "integer", "minimum": 0 }
      }
    },
    "location_distributions": {
      "description": "Optional: where inside each sub-zone cases are likely, as probabilities over micro-cells (geohash) by hour of day and day group. Present only when the request carried location_records.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sub_zone_id", "hour", "day_group", "cells"],
        "properties": {
          "sub_zone_id": { "type": "string", "format": "uuid" },
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "day_group": { "enum": ["weekday", "thursday", "friday", "saturday"] },
          "cells": {
            "type": "array",
            "maxItems": 400,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cell_id", "probability"],
              "properties": {
                "cell_id": { "type": "string", "pattern": "^[0-9b-hjkmnp-z]{5,8}$" },
                "probability": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "explanations": {
      "description": "Optional: why each zone and day has its number. base is the zone's typical daily level in expected cases; base times the product of the drivers' multipliers equals expected, the zone-day total of values (within rounding). Drivers: weekday, trend, annual_season, a calendar or weather effect named as in model_info.feature_set (holiday, ramadan, payday, salary_window, school_break, school_<period>, event_<type>, weather_<kind>, traffic_<kind>), and model_other (the blend with the profile model, sub-zone drift, prayer lull and Ramadan hours). unknown: the day's calendar value was not sent, so the multiplier is the expected effect. Absent when the model has no day-level effects (the profile model, or the ensemble falling back to it).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone_id", "date", "base", "expected", "drivers"],
        "properties": {
          "zone_id": { "type": "string", "format": "uuid" },
          "date": { "type": "string", "format": "date" },
          "base": { "type": "number", "minimum": 0 },
          "expected": { "type": "number", "minimum": 0 },
          "drivers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ExplanationDriver" } }
        }
      }
    }
  },
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "ExplanationDriver": {
      "title": "ExplanationDriver",
      "description": "One driver of a zone-day forecast: a multiplier on the zone's base level. unknown: the day's calendar value was not sent, so the multiplier is the expected effect.",
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "multiplier"],
      "properties": {
        "driver": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "multiplier": { "type": "number", "minimum": 0 },
        "unknown": { "type": "boolean" }
      }
    },
    "DataSource": { "type": "string", "enum": ["SYNTHETIC", "IMPORTED", "LIVE"] },
    "ForecastIntervalValue": {
      "title": "ForecastIntervalValue",
      "description": "One zone x sub-zone x 15-minute interval. low <= expected <= high.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "sub_zone_id",
        "interval_start",
        "interval_index",
        "low",
        "expected",
        "high",
        "field_expected",
        "remote_inferred_expected"
      ],
      "properties": {
        "zone_id": { "$ref": "#/$defs/Uuid" },
        "sub_zone_id": { "$ref": "#/$defs/Uuid" },
        "interval_start": { "type": "string", "format": "date-time" },
        "interval_index": { "type": "integer", "minimum": 0, "maximum": 95 },
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 },
        "field_expected": {
          "description": "Expected cases handled in the field (classified with the rule set).",
          "type": "number",
          "minimum": 0
        },
        "remote_inferred_expected": {
          "description": "Expected cases handled remotely. Inferred until the customer supplies an explicit field.",
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "request_id": "3f6f1b1e-7a55-4c27-9d0a-000000000001",
      "engine": { "name": "forecaster", "version": "0.1.0" },
      "model_version": "placeholder-0.1",
      "generated_at": "2026-09-13T02:05:00+03:00",
      "data_source": "SYNTHETIC",
      "input_data_sources": ["SYNTHETIC"],
      "illustrative": true,
      "rule_set_version": "draft-2026-09",
      "horizon": { "start_date": "2026-09-14", "days": 1 },
      "interval_minutes": 15,
      "intervals_per_day": 96,
      "range_coverage": 0.8,
      "values": [
        {
          "zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000a1",
          "sub_zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000b1",
          "interval_start": "2026-09-14T07:00:00+03:00",
          "interval_index": 28,
          "low": 2.1,
          "expected": 3.4,
          "high": 5.2,
          "field_expected": 2.2,
          "remote_inferred_expected": 1.2
        },
        {
          "zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000a1",
          "sub_zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000b1",
          "interval_start": "2026-09-14T07:15:00+03:00",
          "interval_index": 29,
          "low": 2.4,
          "expected": 3.9,
          "high": 5.8,
          "field_expected": 2.5,
          "remote_inferred_expected": 1.4
        }
      ]
    }
  ]
}
