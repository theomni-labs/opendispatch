{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendispatch.example/contracts/engines/simulator.input.schema.json",
  "title": "SimulatorInput",
  "description": "Input to the service-level simulator: replay a set of cases against a proposed roster and report service levels. The result always carries BOTH 10-minute readings (from registration and from assignment); clock_start_primary only says which one is the headline figure (setting, default assignment). No tenant, customer or role appears here. additionalProperties is false everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "requested_at",
    "data_source",
    "clock_start_primary",
    "threshold_seconds",
    "cases",
    "roster"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "$ref": "#/$defs/Uuid" },
    "requested_at": { "type": "string", "format": "date-time" },
    "data_source": { "$ref": "#/$defs/DataSource" },
    "input_data_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/DataSource" }
    },
    "clock_start_primary": {
      "description": "Setting: when the 10-minute clock starts for the headline figure. Default assignment (a configurable assumption). Both readings are always returned.",
      "type": "string",
      "enum": ["assignment", "registration"],
      "default": "assignment"
    },
    "threshold_seconds": {
      "description": "The service-level threshold. 600 for the 10-minute target.",
      "type": "integer",
      "minimum": 1,
      "default": 600
    },
    "assignment_policy": {
      "description": "How simulated cases are given to agents. nearest: closest agent by travel time (baseline). scorer: the assignment engine's ranking. replay_actual: use the assignments recorded in the cases (a reproduction of history).",
      "type": "string",
      "enum": ["nearest", "scorer", "replay_actual"],
      "default": "nearest"
    },
    "travel_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "average_speed_kmh": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "detour_factor": { "type": "number", "minimum": 1, "maximum": 3 }
      }
    },
    "seed": { "type": "integer" },
    "include_case_outcomes": {
      "description": "When true the output lists every simulated case. Leave false for large replays.",
      "type": "boolean",
      "default": false
    },
    "cases": {
      "description": "Cases to replay. Field cases consume agent capacity; remote_inferred cases go to the remote queue.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "registered_at",
          "zone_id",
          "latitude",
          "longitude",
          "handling"
        ],
        "properties": {
          "case_id": { "$ref": "#/$defs/Uuid" },
          "registered_at": { "type": "string", "format": "date-time" },
          "zone_id": { "$ref": "#/$defs/Uuid" },
          "sub_zone_id": { "$ref": "#/$defs/Uuid" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "handling": { "type": "string", "enum": ["field", "remote_inferred"] },
          "parties_involved": { "type": "integer", "minimum": 0 },
          "on_scene_seconds": {
            "description": "Time on scene to simulate. Omit to let the engine sample from its configured distribution.",
            "type": "integer",
            "minimum": 0
          },
          "actual_assigned_at": {
            "description": "Recorded assignment time; used only by replay_actual. May be earlier than registered_at (a known feature of the sample).",
            "type": ["string", "null"],
            "format": "date-time"
          },
          "actual_agent_id": { "type": ["string", "null"], "format": "uuid" },
          "actual_arrived_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "roster": {
      "description": "The proposed roster to test.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_ref", "assignments"],
      "properties": {
        "roster_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_id", "shift_pattern_id", "start_at", "end_at"],
            "properties": {
              "agent_id": { "$ref": "#/$defs/Uuid" },
              "shift_pattern_id": { "$ref": "#/$defs/Uuid" },
              "zone_id": { "type": ["string", "null"], "format": "uuid" },
              "start_at": { "type": "string", "format": "date-time" },
              "end_at": { "type": "string", "format": "date-time" },
              "break_start_at": { "type": ["string", "null"], "format": "date-time" },
              "break_end_at": { "type": ["string", "null"], "format": "date-time" },
              "start_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "start_longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "DataSource": { "type": "string", "enum": ["SYNTHETIC", "IMPORTED", "LIVE"] }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "request_id": "3f6f1b1e-7a55-4c27-9d0a-000000000003",
      "requested_at": "2026-09-13T07:00:00+03:00",
      "data_source": "SYNTHETIC",
      "input_data_sources": ["SYNTHETIC"],
      "clock_start_primary": "assignment",
      "threshold_seconds": 600,
      "assignment_policy": "nearest",
      "travel_model": { "average_speed_kmh": 40, "detour_factor": 1.3 },
      "seed": 42,
      "include_case_outcomes": false,
      "cases": [
        {
          "case_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000c9",
          "registered_at": "2026-09-14T07:02:00+03:00",
          "zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000a1",
          "sub_zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000b1",
          "latitude": 24.71,
          "longitude": 46.68,
          "handling": "field",
          "parties_involved": 2
        }
      ],
      "roster": {
        "roster_ref": "roster-0001",
        "assignments": [
          {
            "agent_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000d1",
            "shift_pattern_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000f1",
            "zone_id": "3f6f1b1e-7a55-4c27-9d0a-0000000000a1",
            "start_at": "2026-09-14T06:00:00+03:00",
            "end_at": "2026-09-14T14:00:00+03:00",
            "start_latitude": 24.7,
            "start_longitude": 46.7
          }
        ]
      }
    }
  ]
}
