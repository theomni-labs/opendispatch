# Copy to .env (docker compose) or .env.local (pnpm dev). Never commit real values.
# `make env` writes a .env with random credentials for the compose stack.
# Every variable is described in docs/configuration.md.

# Compose stack credentials. docker-compose.yml has development defaults; set these for anything
# beyond a local evaluation.
OPENDISPATCH_OWNER_DB_PASSWORD=
OPENDISPATCH_APP_DB_PASSWORD=
DEMO_SESSION_SECRET=
FEED_SIM_SECRET=
OPENDISPATCH_S3_ACCESS_KEY=
OPENDISPATCH_S3_SECRET_KEY=

# Published port of the web app (bound to 127.0.0.1 only).
OPENDISPATCH_WEB_PORT=3000

# Demo data volume.
OPENDISPATCH_DEMO_HISTORY_WEEKS=52
OPENDISPATCH_DEMO_PAST_FORECAST_DAYS=14
OPENDISPATCH_DEMO_FEED_SPEED=1
# Set to 0 to build the web image without fetching the basemap (offline builds).
OPENDISPATCH_FETCH_MAP=1

# Assistant: off (default), ollama (docker compose --profile assistant up) or openai
# (any OpenAI-compatible endpoint).
OPENDISPATCH_ASSISTANT_PROVIDER=off
OPENDISPATCH_ASSISTANT_MODEL=
OPENDISPATCH_ASSISTANT_OLLAMA_URL=
OPENDISPATCH_ASSISTANT_OPENAI_URL=
OPENDISPATCH_ASSISTANT_API_KEY=

# Running the api from source against your own database:
# OPENDISPATCH_APP_DATABASE_URL=postgres://opendispatch_app:<password>@127.0.0.1:5432/opendispatch_demo
# OPENDISPATCH_OWNER_DATABASE_URL=postgres://opendispatch_owner:<password>@127.0.0.1:5432/opendispatch_demo
# OPENDISPATCH_TEST_DATABASE_URL enables the Go tests that need PostgreSQL.

NEXT_TELEMETRY_DISABLED=1
REDOCLY_TELEMETRY=off
